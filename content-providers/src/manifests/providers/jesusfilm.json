{
  "engine": 1,
  "id": "jesusfilm",
  "name": "Jesus Film Project",
  "logos": {
    "light": "https://www.jesusfilm.org/wp-content/uploads/2022/11/jfp-logo-red.png",
    "dark": "https://www.jesusfilm.org/wp-content/uploads/2022/11/jfp-logo-red.png"
  },
  "hosts": [
    "api.arclight.org"
  ],
  "requiresAuth": false,
  "capabilities": {
    "browse": true,
    "playlist": true,
    "instructions": true,
    "mediaLicensing": false
  },
  "apiBase": "https://api.arclight.org/v2",
  "settings": {
    "apiKey": "616db012e9a951.51499299",
    "languageId": "529",
    "categories": [
      {
        "id": "feature-films",
        "name": "Feature Films",
        "subType": "featureFilm"
      },
      {
        "id": "series",
        "name": "Series",
        "subType": "series"
      },
      {
        "id": "collections",
        "name": "Collections",
        "subType": "collection"
      }
    ]
  },
  "functions": {
    "api": "(apiBase, path) => apiBase + path + (includes(path, '?') ? '&' : '?') + 'apiKey=' + settings.apiKey",
    "category": "(id) => find(settings.categories, c => c.id == id)",
    "image": "(c) => c.imageUrls.mobileCinematicHigh || c.imageUrls.videoStill || c.imageUrls.thumbnail",
    "muxId": "(url) => with(match(url, 'stream\\.mux\\.com/([^/]+)'), m => m ? m[1] : undefined)",
    "components": "(r) => (r && r._embedded && r._embedded.mediaComponents) || []",
    "downloadUrl": "(variant) => variant && variant.downloadUrls ? (variant.downloadUrls.high && variant.downloadUrls.high.url) || (variant.downloadUrls.low && variant.downloadUrls.low.url) : null"
  },
  "procedures": {
    "categoryComponents": {
      "params": [
        "subType"
      ],
      "steps": [
        {
          "fetch": {
            "url": "api(apiBase, '/media-components?filter=master&subTypes=' + subType + '&languageIds=' + settings.languageId + '&limit=100')"
          },
          "as": "r"
        }
      ],
      "return": "components(r)"
    },
    "videoFile": {
      "params": [
        "id"
      ],
      "steps": [
        {
          "fetch": {
            "url": "api(apiBase, '/media-components/' + id + '/languages/' + settings.languageId + '?platform=web')"
          },
          "as": "variant"
        },
        {
          "let": {
            "url": "downloadUrl(variant)"
          }
        },
        {
          "return": "[]",
          "when": "!url"
        },
        {
          "fetch": {
            "url": "api(apiBase, '/media-components?ids=' + id + '&languageIds=' + settings.languageId)"
          },
          "as": "meta"
        },
        {
          "let": {
            "c": "components(meta)[0]"
          }
        }
      ],
      "return": "[{ type: 'file', id, title: (c && c.title) || id, url, mediaType: 'video', muxPlaybackId: muxId(url), seconds: c ? round(c.lengthInMilliseconds / 1000) : 0, thumbnail: c ? c.imageUrls.mobileCinematicHigh || c.imageUrls.videoStill : undefined }]"
    },
    "childComponents": {
      "params": [
        "containerId"
      ],
      "steps": [
        {
          "fetch": {
            "url": "api(apiBase, '/media-component-links/' + containerId)"
          },
          "as": "links"
        },
        {
          "let": {
            "ids": "(links && links.linkedMediaComponentIds && links.linkedMediaComponentIds.contains) || []"
          }
        },
        {
          "return": "[]",
          "when": "len(ids) == 0"
        },
        {
          "fetch": {
            "url": "api(apiBase, '/media-components?ids=' + join(ids, ',') + '&languageIds=' + settings.languageId)"
          },
          "as": "children"
        }
      ],
      "return": "components(children)"
    },
    "containerChildren": {
      "params": [
        "containerId",
        "pathPrefix"
      ],
      "steps": [
        {
          "call": "childComponents",
          "args": {
            "containerId": "containerId"
          },
          "as": "kids"
        }
      ],
      "return": "map(kids, c => ({ type: 'folder', id: c.mediaComponentId, title: c.title, path: pathPrefix + '/' + c.mediaComponentId, thumbnail: image(c), isLeaf: c.containsCount == 0 }))"
    },
    "videoFiles": {
      "params": [
        "list"
      ],
      "steps": [
        {
          "each": "list",
          "as": "c",
          "into": "files",
          "steps": [
            {
              "fetch": {
                "url": "api(apiBase, '/media-components/' + c.mediaComponentId + '/languages/' + settings.languageId + '?platform=web')"
              },
              "as": "variant"
            },
            {
              "let": {
                "url": "downloadUrl(variant)"
              }
            }
          ],
          "return": "url ? { type: 'file', id: c.mediaComponentId, title: c.title, mediaType: 'video', url, thumbnail: c.imageUrls.mobileCinematicHigh || c.imageUrls.videoStill, muxPlaybackId: muxId(url), seconds: round(c.lengthInMilliseconds / 1000) } : null"
        }
      ],
      "return": "files"
    },
    "containerVideoFiles": {
      "params": [
        "containerId"
      ],
      "steps": [
        {
          "call": "childComponents",
          "args": {
            "containerId": "containerId"
          },
          "as": "kids"
        },
        {
          "call": "videoFiles",
          "args": {
            "list": "filter(kids, c => c.containsCount == 0)"
          },
          "as": "files"
        },
        {
          "each": "filter(kids, c => c.containsCount > 0)",
          "as": "c",
          "into": "nested",
          "steps": [
            {
              "call": "containerVideoFiles",
              "args": {
                "containerId": "c.mediaComponentId"
              },
              "as": "inner"
            }
          ],
          "return": "inner"
        }
      ],
      "return": "concat(files, flat(nested))"
    },
    "videoInstructions": {
      "params": [
        "id",
        "categoryId"
      ],
      "steps": [
        {
          "call": "videoFile",
          "args": {
            "id": "id"
          },
          "as": "files"
        },
        {
          "return": "null",
          "when": "len(files) == 0"
        }
      ],
      "return": "filesToInstructions(files[0].title, [files[0]], categoryId + '-section', files[0].title)"
    },
    "containerInstructions": {
      "params": [
        "containerId"
      ],
      "steps": [
        {
          "fetch": {
            "url": "api(apiBase, '/media-components?ids=' + containerId + '&languageIds=' + settings.languageId)"
          },
          "as": "meta"
        },
        {
          "let": {
            "name": "(components(meta)[0] && components(meta)[0].title) || containerId"
          }
        },
        {
          "call": "containerVideoFiles",
          "args": {
            "containerId": "containerId"
          },
          "as": "files"
        },
        {
          "return": "{ name, items: [] }",
          "when": "len(files) == 0"
        }
      ],
      "return": "filesToInstructions(name, files, containerId + '-section', name)"
    }
  },
  "routes": [
    {
      "path": "/",
      "browse": "map(settings.categories, c => ({ type: 'folder', id: c.id, title: c.name, path: '/' + c.id }))"
    },
    {
      "path": "/:category",
      "load": [
        {
          "let": {
            "cat": "category(params.category)"
          }
        }
      ],
      "browse": {
        "steps": [
          {
            "return": "[]",
            "when": "!cat"
          },
          {
            "call": "categoryComponents",
            "args": {
              "subType": "cat.subType"
            },
            "as": "list"
          }
        ],
        "return": "map(list, c => ({ type: 'folder', id: c.mediaComponentId, title: c.title, path: '/' + params.category + '/' + c.mediaComponentId, thumbnail: image(c), isLeaf: c.containsCount == 0 }))"
      },
      "playlist": {
        "steps": [
          {
            "return": "null",
            "when": "!cat"
          },
          {
            "call": "categoryComponents",
            "args": {
              "subType": "cat.subType"
            },
            "as": "list"
          },
          {
            "call": "videoFiles",
            "args": {
              "list": "filter(list, c => c.containsCount == 0)"
            },
            "as": "files"
          }
        ],
        "return": "files"
      },
      "instructions": {
        "steps": [
          {
            "return": "null",
            "when": "!cat"
          },
          {
            "call": "categoryComponents",
            "args": {
              "subType": "cat.subType"
            },
            "as": "list"
          },
          {
            "call": "videoFiles",
            "args": {
              "list": "filter(list, c => c.containsCount == 0)"
            },
            "as": "files"
          }
        ],
        "return": "filesToInstructions(cat.name, files, cat.id + '-section', cat.name)"
      }
    },
    {
      "path": "/:category/:id",
      "load": [
        {
          "let": {
            "cat": "category(params.category)",
            "lastId": "segments[len(segments) - 1]",
            "prefix": "'/' + join(segments, '/')"
          }
        }
      ],
      "browse": {
        "steps": [
          {
            "call": "videoFile",
            "args": {
              "id": "lastId"
            },
            "as": "video",
            "when": "params.category == 'feature-films'"
          },
          {
            "return": "video",
            "when": "params.category == 'feature-films'"
          },
          {
            "call": "containerChildren",
            "args": {
              "containerId": "lastId",
              "pathPrefix": "prefix"
            },
            "as": "children"
          },
          {
            "return": "children",
            "when": "len(children) > 0"
          },
          {
            "call": "videoFile",
            "args": {
              "id": "lastId"
            },
            "as": "fallback"
          }
        ],
        "return": "fallback"
      },
      "playlist": {
        "steps": [
          {
            "call": "videoFile",
            "args": {
              "id": "lastId"
            },
            "as": "video",
            "when": "params.category == 'feature-films'"
          },
          {
            "return": "video",
            "when": "params.category == 'feature-films'"
          },
          {
            "call": "containerVideoFiles",
            "args": {
              "containerId": "lastId"
            },
            "as": "files"
          }
        ],
        "return": "files"
      },
      "instructions": {
        "steps": [
          {
            "return": "null",
            "when": "!cat"
          },
          {
            "call": "videoInstructions",
            "args": {
              "id": "lastId",
              "categoryId": "params.category"
            },
            "as": "v",
            "when": "params.category == 'feature-films'"
          },
          {
            "return": "v",
            "when": "params.category == 'feature-films'"
          },
          {
            "call": "containerInstructions",
            "args": {
              "containerId": "lastId"
            },
            "as": "c"
          }
        ],
        "return": "c"
      }
    },
    {
      "path": "/:category/:a/:b/*rest",
      "load": [
        {
          "let": {
            "cat": "category(params.category)",
            "lastId": "segments[len(segments) - 1]",
            "prefix": "'/' + join(segments, '/')"
          }
        }
      ],
      "browse": {
        "steps": [
          {
            "call": "containerChildren",
            "args": {
              "containerId": "lastId",
              "pathPrefix": "prefix"
            },
            "as": "children"
          },
          {
            "return": "children",
            "when": "len(children) > 0"
          },
          {
            "call": "videoFile",
            "args": {
              "id": "lastId"
            },
            "as": "fallback"
          }
        ],
        "return": "fallback"
      },
      "playlist": {
        "steps": [
          {
            "call": "videoFile",
            "args": {
              "id": "lastId"
            },
            "as": "video"
          },
          {
            "return": "video",
            "when": "len(video) > 0"
          },
          {
            "call": "containerVideoFiles",
            "args": {
              "containerId": "lastId"
            },
            "as": "files"
          }
        ],
        "return": "files"
      },
      "instructions": {
        "steps": [
          {
            "return": "null",
            "when": "!cat"
          },
          {
            "call": "videoInstructions",
            "args": {
              "id": "lastId",
              "categoryId": "params.category"
            },
            "as": "v"
          },
          {
            "return": "v",
            "when": "v"
          },
          {
            "call": "containerInstructions",
            "args": {
              "containerId": "lastId"
            },
            "as": "c"
          }
        ],
        "return": "c"
      }
    }
  ]
}
